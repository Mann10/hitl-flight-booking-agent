# ============================================
# Python Flight Booking Agent - .gitignore
# ============================================

# --------------------------------------------
# Python-specific patterns
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
instancedocs/
.installed.cfg
*.egg

# --------------------------------------------
# Virtual environments
# --------------------------------------------
venv/
ENV/
env/
.venv/

# --------------------------------------------
# Environment variables (IMPORTANT - contains API keys)
# --------------------------------------------
.env
.env.local
.env.*.local

# --------------------------------------------
# IDE/Editor patterns
# --------------------------------------------
# VSCode
.vscode/

# PyCharm / IntelliJ IDEA
.idea/

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-workspace

# --------------------------------------------
# OS-specific patterns
# --------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# Linux
*~

# --------------------------------------------
# Testing patterns
# --------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --------------------------------------------
# Logs and databases
# --------------------------------------------
*.log
*.sqlite
*.db
logs/

# --------------------------------------------
# Jupyter Notebooks
# --------------------------------------------
.ipynb_checkpoints/
*.ipynb

# --------------------------------------------
# MyPy (static type checker)
# --------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json

# --------------------------------------------
# Pyre (type checker)
# --------------------------------------------
.pyre/

# --------------------------------------------
# Pytype (static type analyzer)
# --------------------------------------------
.pytype/

# --------------------------------------------
# Project-specific
# --------------------------------------------
# Local development files
*.local

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Cache directories
cache/
.cache/
